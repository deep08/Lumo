{
  "expo": {
    "name": "Lumo",
    "slug": "lumo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FAF8F8"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Lumo to take photos of your meals.",
          "photosPermission": "Allow Lumo to choose meal photos from your library."
        }
      ],
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Lumo to take photos of your meals.",
        "NSPhotoLibraryUsageDescription": "Allow Lumo to choose meal photos from your library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
